# ---- LLM Configuration ----
OPENAI_API_KEY=

# Core Agent structured language understanding
AGENT_LLM_ENABLED=true
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_REASONING_EFFORT=none
AGENT_LLM_BASE_URL=https://api.openai.com/v1

# Contextual user-message rewrite
AGENT_REWRITE_ENABLED=true
AGENT_REWRITE_PROVIDER=openai
AGENT_REWRITE_MODEL=gpt-4o-mini
AGENT_REWRITE_TIMEOUT_SECONDS=30
AGENT_REWRITE_REASONING_EFFORT=none
AGENT_REWRITE_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=

# ---- Voice prototype (speech -> agent -> speech) ----
VOICE_PROVIDER=auto
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1
VOICE_OPENAI_TTS_VOICE=nova
VOICE_GEMINI_MODEL=gemini-2.0-flash
VOICE_TIMEOUT_SECONDS=30

# Privacy-first post-ASR correction
VOICE_TRANSCRIPT_REWRITE_ENABLED=true
VOICE_TRANSCRIPT_REWRITE_MODEL=gpt-4o-mini
VOICE_TRANSCRIPT_REWRITE_BASE_URL=https://api.openai.com/v1
VOICE_TRANSCRIPT_REWRITE_TIMEOUT_SECONDS=2
VOICE_TRANSCRIPT_REWRITE_REASONING_EFFORT=low
VOICE_TRANSCRIPT_REWRITE_ASR_CONFIDENCE_THRESHOLD=0.85
VOICE_TRANSCRIPT_REWRITE_MINIMUM_CONFIDENCE=0.85
VOICE_TRANSCRIPT_REWRITE_CONTEXT_WINDOW_TURNS=3
VOICE_TRANSCRIPT_REWRITE_MEMORY_MAX_CORRECTIONS=6

# ---- Database ----
#DATABASE_URL=postgresql://postgres:123456789%40%40KAI**%23%23@db.bmnnykrmesauqaikbcot.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.bmnnykrmesauqaikbcot:123456789%40%40KAI**%23%23@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

REDIS_URL=redis://127.0.0.1:6379/0
CONVERSATION_MEMORY_TTL_SECONDS=600
REDIS_SOCKET_TIMEOUT_SECONDS=1

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# ---- LangSmith (AI Logs) ----
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging & AI Ingestion Hook ----
LOG_LEVEL=INFO
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=ai20k_hP-gTCP99ThpNTQZ5K5qrg4wDdqmAbIC
AI_LOG_DIR=.ai-log

# ---- Voice AI Additive Settings ----
VOICE_ENABLED=true
GROQ_API_KEY=
VOICE_ASR_MODEL=whisper-large-v3-turbo
VOICE_ASR_LANGUAGE=vi
VOICE_TTS_RATE=1.0
VOICE_TTS_PRIMARY_VOICE=vi-VN-HoaiMyNeural
VOICE_TTS_FALLBACK_VOICES=vi-VN-NamMinhNeural
VOICE_TTS_TIMEOUT_SECONDS=3.0
VOICE_TTS_REQUEST_DEADLINE_SECONDS=15
VOICE_TTS_MAX_ATTEMPTS_PER_VOICE=1
VOICE_TTS_CIRCUIT_FAILURE_THRESHOLD=5
VOICE_TTS_CIRCUIT_COOLDOWN_SECONDS=5
VOICE_BROWSER_TTS_FALLBACK_ENABLED=false
VOICE_VAD_BACKEND=energy
VOICE_VAD_SILENCE_MS=900
VOICE_SILERO_MODEL_PATH=
VOICE_MIN_UTTERANCE_RMS=0.01
VOICE_BOOKING_CONFIRMATION_CONFIDENCE_THRESHOLD=0.80

# ---- Local Vietnamese ASR (ZipFormer INT8 CPU) ----
ASR_ENABLED=true
ASR_NUM_THREADS=4
ASR_REQUIRED=false
ASR_MODEL_ID=hynt/Zipformer-30M-RNNT-6000h
ASR_MODEL_REVISION=24ed30248e1c96bb690c81c24ab4e056f8cd9fce
ASR_MODEL_DIR=data/models/asr/sherpa-onnx-zipformer-vi-30M-int8-2026-02-09
ASR_ENCODER_PATH=encoder.int8.onnx
ASR_DECODER_PATH=decoder.onnx
ASR_JOINER_PATH=joiner.int8.onnx
ASR_TOKENS_PATH=tokens.txt
ASR_NUM_THREADS=2
ASR_MAX_CONCURRENCY=2
ASR_QUEUE_SIZE=8
ASR_SAMPLE_RATE=16000
ASR_FEATURE_DIM=80
ASR_INFERENCE_TIMEOUT_SECONDS=45
MAX_AUDIO_SIZE_MB=15
MAX_AUDIO_DURATION_SECONDS=60
ASR_FFMPEG_PATH=ffmpeg
# ---- LiveKit-native Voice Agent (Phase 1; keep legacy until E2E gate passes) ----
VOICE_RUNTIME=legacy
VITE_VOICE_RUNTIME=legacy

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

LIVEKIT_AGENT_NAME=alosm-voice
LIVEKIT_NUM_IDLE_PROCESSES=1
LIVEKIT_INITIALIZE_PROCESS_TIMEOUT_SECONDS=30

LIVEKIT_STT_PROVIDER=elevenlabs
LIVEKIT_STT_MODEL=scribe_v2_realtime
LIVEKIT_STT_LANGUAGE=vi
ELEVEN_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=project-82f5ef34-4c29-48b5-afd
GOOGLE_STT_LOCATION=asia-southeast1
LIVEKIT_LLM_PROVIDER=openai
LIVEKIT_LLM_MODEL=gpt-4.1-mini

# The LLM uses OPENAI_API_KEY directly. TTS calls Google Cloud directly via the
# official plugin, using Application Default Credentials or this credential file.
LIVEKIT_TTS_PROVIDER=openai
LIVEKIT_TTS_MODEL=gpt-4o-mini-tts
LIVEKIT_TTS_VOICE=ash
LIVEKIT_TTS_LANGUAGE=vi
LIVEKIT_TTS_TIMEOUT_SECONDS=30
LIVEKIT_TTS_MAX_RETRIES=1
LIVEKIT_TTS_RETRY_INTERVAL_SECONDS=0.5
LIVEKIT_GOOGLE_TTS_FALLBACK_MODEL=chirp_3
LIVEKIT_GOOGLE_TTS_FALLBACK_VOICE=vi-VN-Chirp3-HD-Autonoe

# LiveKit's local Silero VAD commits turns and handles barge-in.
LIVEKIT_TURN_DETECTION=vad
LIVEKIT_STT_SERVER_VAD_SILENCE_THRESHOLD_SECONDS=1.5
LIVEKIT_STT_SERVER_VAD_THRESHOLD=0.4
LIVEKIT_STT_SERVER_VAD_MIN_SPEECH_DURATION_MS=250
LIVEKIT_STT_SERVER_VAD_MIN_SILENCE_DURATION_MS=2000

# Privacy-safe defaults. Do not enable before consent/retention policy is approved.
LIVEKIT_RECORD_AUDIO=false
LIVEKIT_RECORD_TRANSCRIPT=false
LIVEKIT_RECORD_TRACES=false
LIVEKIT_RECORD_LOGS=false
LIVEKIT_CONNECTION_TIMEOUT_SECONDS=10
LIVEKIT_TOKEN_TTL_SECONDS=600

LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY=your-langfuse-secret
LANGFUSE_PUBLIC_KEY=your-langfuse-public
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_FLUSH_TIMEOUT_SECONDS=5